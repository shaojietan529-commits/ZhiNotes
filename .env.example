# ZhiNotes cloud enablement
# Copy to .env.local for local testing. Do not commit real secrets.

# Keep false until you explicitly want API routes to talk to Supabase.
ZHINOTES_CLOUD_ENABLED=false

# Keep false for the first web-hosted local-only deployment.
# Set true only after payload preview, permissions, and rollback paths are ready.
ZHINOTES_ALLOW_CLOUD_WRITES=false

# Public app URL used for auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional auth redirect allowlist. Comma-separated origins.
ZHINOTES_AUTH_REDIRECT_ORIGINS=http://localhost:3000
